{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lexora dictionary entry (self-built, proprietary data asset)",
  "type": "object",
  "required": ["lemma", "senses", "examples", "tags"],
  "properties": {
    "lemma": { "type": "string", "minLength": 2 },
    "phoneticUS": { "type": "string" },
    "senses": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object", "required": ["pos", "zh"],
        "properties": { "pos": { "type": "string" }, "zh": { "type": "string", "minLength": 1 } }
      }
    },
    "definitionEn": { "type": "string" },
    "examples": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "required": ["en", "zh"],
        "properties": { "en": { "type": "string" }, "zh": { "type": "string" } }
      }
    },
    "collocations": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
