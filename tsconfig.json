{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@elp/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["packages/core/src/**/*.ts", "packages/core/test/**/*.ts", "packages/obsidian/src/**/*.ts"]
}
